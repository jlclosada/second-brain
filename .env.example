# Copia este archivo a .env y rellénalo.

# Contraseña para entrar en la app (desde el PC o el móvil)
APP_PASSWORD=pon-aqui-una-contraseña-larga

# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys).
# Opcional: sin ella los documentos se clasifican con reglas básicas y no hay modo "Preguntar".
ANTHROPIC_API_KEY=

# Modelo para clasificar y para responder preguntas
CLASSIFY_MODEL=claude-haiku-5-5
CHAT_MODEL=claude-haiku-5-5
