# Copia este archivo a .env y rellénalo.

# Contraseña inicial para entrar (desde el PC o el móvil). Después se cambia
# desde Ajustes y se guarda cifrada con Argon2; cambiarla aquí ya no tiene efecto.
# Si la olvidas: docker compose exec app python -m app.cli reset-password
APP_PASSWORD=pon-aqui-una-contraseña-larga

# Zona horaria para recordatorios, el resumen del día y el calendario.
TIMEZONE=Europe/Madrid

# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys).
# Opcional: sin ella los documentos y la captura rápida usan reglas, y no hay asistente.
ANTHROPIC_API_KEY=

# Modelo para clasificar documentos y entender la captura rápida (barato y rápido)
CLASSIFY_MODEL=claude-haiku-5-5
# Modelo del asistente (consulta y crea tareas, eventos y notas)
CHAT_MODEL=claude-opus-5-5

# Si accedes por HTTPS a través de un proxy que no avisa (raro): COOKIE_SECURE=true
# COOKIE_SECURE=

# Contacto que se envía a los servicios de notificaciones push.
# VAPID_CONTACT=mailto:tu@correo.com
