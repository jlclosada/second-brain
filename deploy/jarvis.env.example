# Configuración de Jarvis en el servidor: /srv/jarvis/config/jarvis.env (chmod 600).
# migrate-from-mac.sh la crea a partir de tu .env del Mac; esta plantilla es para empezar de cero.
# La base de datos, el vault y las carpetas las pone docker-compose.prod.yml: no las pongas aquí.

# Contraseña inicial (después se cambia desde Ajustes y se guarda con Argon2).
APP_PASSWORD=pon-aqui-una-contraseña-larga

TIMEZONE=Europe/Madrid

# Claude (opcional, pero sin ella no hay asistente)
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-5-5
CHAT_MODEL=claude-haiku-5-5

# Google (Gmail y Calendar). También se pueden pegar desde Ajustes → Conexiones.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub (opcional)
# GITHUB_TOKEN=

# Dirección de Jarvis en tu Tailscale. setup-server.sh la rellena sola.
PUBLIC_URL=

# Ordenar sola una carpeta (p. ej. tus Descargas del Mac sincronizadas con Syncthing
# en /srv/jarvis/downloads). Desactivado por defecto.
# DOWNLOADS_DIR=/downloads

# VAPID_CONTACT=mailto:tu@correo.com
